{
  "mcpServers": {
    "tum-reentrancy-guard-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "TUM Munich",
        "PROJECT_TICKER": "TUMGUARD"
      },
      "tools": [
        {
          "name": "verify_tumguard_invariants",
          "description": "Verifies deterministic invariants for TUM Reentrancy Guard AI on TUM Munich."
        },
        {
          "name": "execute_tumguard_action",
          "description": "Executes authenticated Security state transition."
        }
      ]
    }
  }
}